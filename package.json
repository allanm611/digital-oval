{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.4.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:check": "tsc --noEmit",
    "build:lint": "npm run lint && tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "vite-bundle-analyzer",
    "deploy:prod": "rm .vercel/project.json 2>/dev/null; vercel --local-config vercel.prod.json --prod --yes",
    "deploy:staging": "rm .vercel/project.json 2>/dev/null; vercel --local-config vercel.staging.json --prod --yes"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-sql": "^6.10.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.8",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@tanstack/react-query": "^5.100.9",
    "@uiw/react-codemirror": "^4.25.10",
    "lucide-react": "^0.344.0",
    "markdown-it": "^14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.3.0",
    "sql-formatter": "^15.7.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^5.4.2",
    "vite-bundle-analyzer": "^1.3.2"
  }
}
